# All optional; defaults are free and local.
OCR_ENGINE=tesseract            # tesseract | paddleocr | easyocr (extras in requirements-extra.txt)
REVIEW_THRESHOLD=0.75           # fields below this confidence go to the review queue
DB_PATH=data/documind.db
UPLOAD_DIR=data/uploads
REDIS_URL=                      # e.g. redis://redis:6379/0 to dispatch jobs through Redis
EMBEDDED_WORKER=false           # true: run the worker thread inside the API process
WORKER_POLL_SECONDS=1.0
JOB_VISIBILITY_TIMEOUT_S=120
MAX_ATTEMPTS=3
MAX_UPLOAD_BYTES=10000000
API_KEY=                        # when set, /v1/* requires the X-API-Key header
CORS_ORIGINS=                   # comma separated origins; empty disables CORS
LOG_LEVEL=INFO
